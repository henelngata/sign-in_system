    "@libsql/client": "^0.18.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.9",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
