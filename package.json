{
  "name": "parliament-daily-register",
  "version": "1.0.0",
  "description": "Daily sign-in register for directors and officers, restricted to parliament network",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server.mjs",
    "build": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server.mjs",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test test/*.test.mjs"
  },
