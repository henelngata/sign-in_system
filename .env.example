# Copy to .env and edit.

# REQUIRED: the parliament network ranges allowed to use the register.
# Comma-separated IPs or CIDR ranges (IPv4 or IPv6). Ask ICT for the exact LAN/Wi-Fi ranges.
# Anything not listed gets "Access restricted", including the admin pages.
ALLOWED_NETWORKS=127.0.0.1,10.10.0.0/16,192.168.20.0/24

# Shown in the header.
ORG_NAME=Parliament

# Timezone used to decide "today" and display times. Africa/Nairobi = East Africa Time (EAT, UTC+3).
TIMEZONE=Africa/Nairobi

PORT=3000
# 0.0.0.0 = IPv4 only; use :: to also accept IPv6.
HOST=0.0.0.0

# Long random string; keeps admin logins valid across restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Number of reverse proxies (nginx, IIS, load balancer) in front of this app.
# 0 = users connect straight to Node. Set to 1 ONLY if nginx/etc. is in front AND
# Node is not reachable directly, otherwise someone could fake their IP with a header.
TRUST_PROXY_HOPS=0

# Set to true when served over HTTPS.
SECURE_COOKIES=false

# Lock an officer's PIN after this many wrong attempts, for this many minutes.
MAX_PIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Local SQLite file (used when TURSO_DATABASE_URL is not set).
DB_PATH=data/register.db

# Hosted database. REQUIRED on Vercel, where local files are wiped.
# Adding Turso from the Vercel Marketplace sets these for you.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# ---- On Vercel, set these in Project → Settings → Environment Variables instead of this file:
#   ALLOWED_NETWORKS  the parliament's PUBLIC IP address(es), not 10.x / 192.168.x
#   SESSION_SECRET    required (Vercel doesn't run server.mjs, which would otherwise make one up)
#   TIMEZONE, ORG_NAME, and the TURSO_* variables above
#   SECURE_COOKIES=true   (Vercel is always HTTPS)
# PORT, HOST and TRUST_PROXY_HOPS don't apply on Vercel.
